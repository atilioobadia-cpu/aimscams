{
  "name": "aimscams",
  "version": "0.0.0",
  "private": true,
  "description": "AIMSCAMS - Alpha Integrated Management System - CAMS. Tanzania SACCO and microfinance back office.",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @aimscams/api\" \"npm run dev -w @aimscams/web\"",
    "dev:web": "npm run dev -w @aimscams/web",
    "dev:api": "npm run dev -w @aimscams/api",
    "build": "npm run build -w @aimscams/web && npm run build -w @aimscams/api && npm run build -w @aimscams/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm run generate -w @aimscams/db",
    "db:validate": "npm run validate -w @aimscams/db",
    "db:migrate": "npm run migrate -w @aimscams/db",
    "db:deploy": "npm run migrate:deploy -w @aimscams/db",
    "db:studio": "npm run studio -w @aimscams/db"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
