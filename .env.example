# AIMSCAMS - one installation per institution, one .env per installation.
# Copy to .env for local development. Never commit real values.
# Every variable in docs/12 §4 is listed. Values marked REQUIRED fail startup.

# Core
NODE_ENV="development"
APP_ENV="local"
TZ="Africa/Dar_es_Salaam"
PUBLIC_BASE_URL="http://localhost:4000"
INSTITUTION_CODE="AIM-DEMO"
INSTITUTION_DIALECT="TCDC"
DEFAULT_LOCALE="en-TZ"
INSTITUTION_NAME="AIMSCAMS Demo SACCO"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Database
DATABASE_URL="postgresql://aimscams:aimscams@localhost:5432/aimscams?schema=public"

# Queue
REDIS_URL="redis://localhost:6379"

# Auth (REQUIRED from Phase 2; generate with `openssl rand -base64 48`)
JWT_SECRET=""
JWT_TTL="8h"
TOTP_ENCRYPTION_KEY=""
SESSION_COOKIE_DOMAIN="localhost"

# Storage (MinIO locally, private S3-compatible bucket in production)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="aimscams-documents"
S3_REGION="us-east-1"
S3_ACCESS_KEY="aimscams"
S3_SECRET_KEY="aimscams-local-only"
S3_FORCE_PATH_STYLE="true"

# Mail
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@aimscams.local"

# SMS
SMS_PROVIDER_URL=""
SMS_SENDER_ID=""
SMS_API_KEY=""

# Payments - per provider (M-Pesa, Mixx by Yas, Airtel Money, bank API)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MIXBY_YAS_API_KEY=""
MIXBY_YAS_PUBLIC_KEY=""
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
BANK_API_CLIENT_ID=""
BANK_API_CLIENT_SECRET=""

# Observability
METRICS_TOKEN=""
LOG_LEVEL="info"

# Backups
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
BACKUP_PASSPHRASE=""
