// AIMSCAMS database schema.
// Phase 0 contains infrastructure metadata only; business models start in Phase 2.
// Invariants that Prisma cannot express (RLS, append-only ledger, period guard) live
// in hand-written SQL migrations and packages/ledger/src/schema.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Installation-level metadata. Not business data and not tenant-scoped.
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_meta")
}

// Phase 2 identity, tenancy and access.

enum InstitutionDialect {
  TCDC
  BOT
}

enum BranchStatus {
  OPEN
  CLOSED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model Organisation {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  name           String
  registrationNo String?
  dialect        InstitutionDialect
  timezone       String             @default("Africa/Dar_es_Salaam")
  locale         String             @default("en-TZ")
  /// External logo override. An uploaded logo is served from `logoData` instead.
  logoUrl        String?
  logoMime       String?
  logoData       Bytes?
  logoUpdatedAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  branches      Branch[]
  users         User[]
  roles         Role[]
  auditEvents   AuditEvent[]
  loginAttempts LoginAttempt[]
  loanProducts  LoanProduct[]
  savingsProducts SavingsProduct[]
  interestRates InterestRate[]
  feePenalties  FeePenalty[]
  provisioningRules ProvisioningRule[]
  membershipPolicies MembershipPolicy[]
  creditProductPolicies CreditProductPolicy[]
  holidays Holiday[]

  @@map("organisation")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  code           String
  name           String
  addressLine    String?
  region         String
  district       String?
  ward           String?
  councilType    String?
  employeeCount  Int          @default(0)
  status         BranchStatus @default(OPEN)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        User[]
  sessions     Session[]
  auditEvents  AuditEvent[]
  hours        BranchHour[]
  holidays     Holiday[]

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("branch")
}

/// One row per weekday. Times are minutes from midnight so no timezone can shift them.
model BranchHour {
  id           String  @id @default(uuid()) @db.Uuid
  branchId     String  @db.Uuid
  weekday      Int
  isClosed     Boolean @default(false)
  opensMinute  Int     @default(0)
  closesMinute Int     @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday])
  @@index([branchId])
  @@map("branch_hour")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  organisationId   String     @db.Uuid
  branchId         String?    @db.Uuid
  email            String
  fullName         String
  phone            String?
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  mfaEnabled       Boolean    @default(false)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles               UserRole[]
  sessions            Session[]
  mfaSecret           MfaSecret?
  mfaChallenges       MfaChallenge[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts       LoginAttempt[]
  auditEvents         AuditEvent[]

  @@unique([organisationId, email])
  @@index([organisationId, status])
  @@index([branchId])
  @@map("app_user")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organisationId, code])
  @@map("role")
}

model Permission {
  key         String  @id
  entity      String
  action      String
  description String?

  roles RolePermission[]

  @@index([entity, action])
  @@map("permission")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [key], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  branchId   String?   @db.Uuid
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

model MfaSecret {
  userId             String   @id @db.Uuid
  encryptedSecret    String
  recoveryCodeHashes String[]
  lastUsedCounter    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secret")
}

/// A short-lived, single-use login challenge issued after the password step.
/// Stored server-side so a stolen challenge cannot be replayed after use.
model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("mfa_challenge")
}

/// A short-lived, single-use password-reset token. Only the SHA-256 hash is
/// stored; a database leak must not produce working reset links.
model PasswordResetToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique
  requestedIp        String?
  requestedUserAgent String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([requestedIp, createdAt])
  @@map("password_reset_token")
}

model LoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid
  userId         String?  @db.Uuid
  email          String
  succeeded      Boolean
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([organisationId, createdAt])
  @@map("login_attempt")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  branchId       String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actorLabel     String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("audit_event")
}

model LoanProduct {
  id                      String            @id @default(uuid()) @db.Uuid
  organisationId          String            @db.Uuid
  code                    String
  name                    String
  status                  LoanProductStatus @default(DRAFT)
  description             String?
  minPrincipalMinor       BigInt
  maxPrincipalMinor       BigInt
  minTenureMonths         Int
  maxTenureMonths         Int
  interestRateBp          Int
  interestMethod          String
  repaymentFrequency      String
  gracePeriodDays         Int               @default(0)
  arrearsClassificationDays Int             @default(30)
  managementFeeBp         Int               @default(0)
  penaltyBp               Int               @default(0)
  principalAccountId      String?
  interestIncomeAccountId String?
  chargesIncomeAccountId  String?
  penaltyIncomeAccountId  String?
  workflowStages          Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("loan_product")
}

enum LoanProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}


model SavingsProduct {
  id                      String               @id @default(uuid()) @db.Uuid
  organisationId          String               @db.Uuid
  code                    String
  name                    String
  status                  SavingsProductStatus @default(DRAFT)
  description             String?
  allowedAsGuarantor      Boolean              @default(false)
  allowedAsCollateral     Boolean              @default(false)
  allowedMultipleAccounts Boolean              @default(false)
  allowInterestPayout     Boolean              @default(false)
  minBalanceMinor         BigInt               @default(0)
  interestRateBp          Int                  @default(0)
  interestPayoutFrequency String               @default("MONTHLY")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("savings_product")
}

enum SavingsProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model InterestRate {
  id          String             @id @default(uuid()) @db.Uuid
  organisationId String          @db.Uuid
  code        String
  name        String
  status      InterestRateStatus @default(ACTIVE)
  rateBp      Int
  period      String             @default("ANNUAL")
  effectiveFrom DateTime?
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("interest_rate")
}

enum InterestRateStatus {
  ACTIVE
  INACTIVE
}

model FeePenalty {
  id            String             @id @default(uuid()) @db.Uuid
  organisationId String            @db.Uuid
  code          String
  name          String
  kind          FeePenaltyKind
  amountType    FeeAmountType
  amountMinor   BigInt?
  rateBp        Int?
  glAccountId   String?
  status        FeePenaltyStatus   @default(ACTIVE)
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("fee_penalty")
}

enum FeePenaltyKind {
  FEE
  PENALTY
}

enum FeeAmountType {
  FIXED
  PERCENTAGE
}

enum FeePenaltyStatus {
  ACTIVE
  INACTIVE
}

model ProvisioningRule {
  id            String                 @id @default(uuid()) @db.Uuid
  organisationId String                @db.Uuid
  code          String
  name          String
  status        ProvisioningRuleStatus @default(ACTIVE)
  daysFrom      Int
  daysTo        Int?
  rateBp        Int
  glAccountId   String?
  description   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("provisioning_rule")
}

enum ProvisioningRuleStatus {
  ACTIVE
  INACTIVE
}

model MembershipPolicy {
  id                     String                  @id @default(uuid()) @db.Uuid
  organisationId         String                  @db.Uuid
  code                   String
  name                   String
  status                 MembershipPolicyStatus  @default(DRAFT)
  description            String?
  memberType             String                  @default("INDIVIDUAL")
  minNextOfKin           Int                     @default(1)
  maxNextOfKin           Int                     @default(2)
  dormantDays            Int                     @default(365)
  allowWithdraw          Boolean                 @default(true)
  autoActiveUponDeposit  Boolean                 @default(false)
  enableMemberVerification Boolean               @default(false)
  verificationType       String?
  boardApproval          Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("membership_policy")
}

enum MembershipPolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model CreditProductPolicy {
  id             String                    @id @default(uuid()) @db.Uuid
  organisationId String                    @db.Uuid
  code           String
  name           String
  status         CreditProductPolicyStatus @default(DRAFT)
  description    String?
  content        Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("credit_product_policy")
}

enum CreditProductPolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  branchId       String?  @db.Uuid
  name           String
  holidayDate    DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organisationId, holidayDate])
  @@map("holiday")
}
